theme = Solarized Dark - Vivid
# A grayer navy background and brighter text than the theme, for more contrast.
# The foreground matches nvim's (solarized-osaka with vivid_brightness = 0.5)
background = #0b1522
foreground = #c6d6d7
background-opacity = 0.85
background-blur = 20
window-padding-x = 8
window-padding-y = 8
cursor-style = block
cursor-style-blink = true

font-family = PlemolJP Console NF
# PlemolJP lacks the check box and cross symbols, and other fallback fonts overflow the cell
font-codepoint-map = U+2610-U+2612,U+2717-U+2718=Menlo
font-size = 14

# tmux and others break when the ssh host doesn't know xterm-ghostty (falls back to TERM=xterm-256color if sending fails)
shell-integration-features = ssh-env,ssh-terminfo
macos-option-as-alt = true
unfocused-split-opacity = 0.85
keybind = super+d=new_split:right
keybind = chain=equalize_splits
keybind = super+shift+d=new_split:down
keybind = chain=equalize_splits
